+#!/usr/bin/env python3
+"""Independent cross-checks of gram_entry.py.
+
+* N = 1: T~ = [0, C(1)] directly; integrals in closed form.
+* N = 2: exact rational polygon clipping of each stratum (no inclusion-exclusion, no Dirichlet
+  formula) and exact integration over a triangle fan (Fractions).
+* N = 3 and N = 45: Monte Carlo, uniform samples from the simplex {x >= 0, sum x <= L}
+  (Dirichlet(1,...,1)), testing the rough-cap condition directly.
+"""
+import sys
+from fractions import Fraction as Fr
+import numpy as np
+import gram_entry as G
+
+L, g, C = G.L, G.g, G.C
+
+
+def check_N1():
+    c1 = C(1)
+    vol = c1
+    ent = sum(Fr(1)) if False else None
+    # (L - x) x^2 integrated over [0, C(1)]
+    ent = L * c1 ** 3 / 3 - c1 ** 4 / 4
+    e, _ = G.entry_LmP1_P2(1)
+    assert G.volume(1) == vol, (G.volume(1), vol)
+    assert e == ent, (e, ent)
+    print("N=1 exact: volume and entry agree")
+
+
+def clip(poly, a, b, c):
+    """Clip convex polygon (list of (x,y) Fractions) to a*x + b*y <= c."""
+    out = []
+    n = len(poly)
+    for i in range(n):
+        P, Q = poly[i], poly[(i + 1) % n]
+        fP = a * P[0] + b * P[1] - c
+        fQ = a * Q[0] + b * Q[1] - c
+        if fP <= 0:
+            out.append(P)
+        if (fP < 0 < fQ) or (fQ < 0 < fP):
+            t = fP / (fP - fQ)
+            out.append((P[0] + t * (Q[0] - P[0]), P[1] + t * (Q[1] - P[1])))
+    return out
+
+
+# Exact polynomial arithmetic over Fractions: a polynomial is {(i, j): coeff} in (x, y) or (u, v).
+def pmul(p, q):
+    out = {}
+    for (a, b), c in p.items():
+        for (d, e), f in q.items():
+            out[(a + d, b + e)] = out.get((a + d, b + e), 0) + c * f
+    return out
+
+
+def padd(p, q):
+    out = dict(p)
+    for k, v in q.items():
+        out[k] = out.get(k, 0) + v
+    return out
+
+
+def ppow(p, n):
+    out = {(0, 0): Fr(1)}
+    for _ in range(n):
+        out = pmul(out, p)
+    return out
+
+
+def tri_integral(f, A, B, Cc):
+    """Integral of f (dict in x, y) over the triangle ABC, exact."""
+    from math import factorial
+    xs = {(0, 0): A[0], (1, 0): B[0] - A[0], (0, 1): Cc[0] - A[0]}
+    ys = {(0, 0): A[1], (1, 0): B[1] - A[1], (0, 1): Cc[1] - A[1]}
+    jac = abs((B[0] - A[0]) * (Cc[1] - A[1]) - (Cc[0] - A[0]) * (B[1] - A[1]))
+    h = {}
+    for (i, j), c in f.items():
+        h = padd(h, {k: c * v for k, v in pmul(ppow(xs, i), ppow(ys, j)).items()})
+    tot = sum(c * Fr(factorial(i) * factorial(j), factorial(i + j + 2)) for (i, j), c in h.items())
+    return jac * tot
+
+
+def poly_integral(f, poly):
+    if len(poly) < 3:
+        return Fr(0)
+    return sum(tri_integral(f, poly[0], poly[i], poly[i + 1]) for i in range(1, len(poly) - 1))
+
+
+def check_N2():
+    big = Fr(10)
+    box = [(Fr(0), Fr(0)), (big, Fr(0)), (big, big), (Fr(0), big)]
+    strata = []
+    for R in [(), (0,), (1,), (0, 1)]:
+        P = list(box)
+        for i in range(2):
+            a, b = (1, 0) if i == 0 else (0, 1)
+            if i in R:
+                P = clip(P, -a, -b, -g)       # x_i >= g
+            else:
+                P = clip(P, a, b, g)          # x_i <= g
+        P = clip(P, 1, 1, L)                  # x1 + x2 <= L
+        ca = 1 if 0 in R else 0
+        cb = 1 if 1 in R else 0
+        if R:
+            P = clip(P, ca, cb, C(len(R)))    # rough mass <= C(|R|)
+        strata.append(P)
+    f_vol = {(0, 0): Fr(1)}
+    # (L - x - y)(x^2 + y^2)
+    f_ent = pmul({(0, 0): L, (1, 0): Fr(-1), (0, 1): Fr(-1)}, {(2, 0): Fr(1), (0, 2): Fr(1)})
+    vol = sum(poly_integral(f_vol, P) for P in strata)
+    ent = sum(poly_integral(f_ent, P) for P in strata)
+    e, _ = G.entry_LmP1_P2(2)
+    v = G.volume(2)
+    assert v == vol, (v, vol)
+    assert e == ent, (e, ent)
+    print("N=2 exact polygon integration: volume", vol, "and entry", ent, "agree")
+
+
+def mc(N, samples, batch=500_000, seed=1):
+    rng = np.random.default_rng(seed)
+    Lf, gf = float(L), float(g)
+    caps = np.array([float(C(m)) for m in range(N + 1)])
+    s_vol = s_ent = s_ent2 = 0.0
+    done = 0
+    while done < samples:
+        b = min(batch, samples - done)
+        E = rng.exponential(size=(b, N + 1))
+        x = Lf * E[:, :N] / E.sum(axis=1, keepdims=True)   # uniform on {x >= 0, sum x <= L}
+        rough = x > gf
+        s = rough.sum(axis=1)
+        rho = np.where(rough, x, 0.0).sum(axis=1)
+        ok = rho <= caps[s]
+        f = (Lf - x.sum(axis=1)) * (x ** 2).sum(axis=1) * ok
+        s_vol += ok.sum()
+        s_ent += f.sum()
+        s_ent2 += (f ** 2).sum()
+        done += b
+    simplex_vol = Lf ** N / float(np.prod(np.arange(1, N + 1, dtype=float)))
+    mean = s_ent / samples
+    se = np.sqrt(max(s_ent2 / samples - mean ** 2, 0) / samples)
+    vol_hat = simplex_vol * s_vol / samples
+    p = s_vol / samples
+    vol_se = simplex_vol * np.sqrt(p * (1 - p) / samples)
+    return vol_hat, vol_se, simplex_vol * mean, simplex_vol * se, p
+
+
+def check_mc(N, samples):
+    vol_hat, vol_se, ent_hat, ent_se, p = mc(N, samples)
+    e, _ = G.entry_LmP1_P2(N)
+    v = G.volume(N)
+    zv = (vol_hat - float(v)) / vol_se
+    ze = (ent_hat - float(e)) / ent_se
+    print(f"N={N} Monte Carlo ({samples} samples, acceptance {p:.4f}): "
+          f"volume exact {float(v):.6e} est {vol_hat:.6e} (z={zv:+.2f}); "
+          f"entry exact {float(e):.6e} est {ent_hat:.6e} (z={ze:+.2f})")
+    assert abs(zv) < 4 and abs(ze) < 4
+
+
+if __name__ == "__main__":
+    check_N1()
+    check_N2()
+    check_mc(3, 4_000_000)
+    check_mc(45, int(sys.argv[1]) if len(sys.argv) > 1 else 4_000_000)
