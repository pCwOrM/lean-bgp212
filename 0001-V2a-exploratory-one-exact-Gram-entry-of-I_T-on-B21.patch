+/-! # V2a (exploratory): one exact Gram entry of `I_T` on `B₂₁`
+
+EXPLORATORY, isolated from A0–V1: this file belongs to no `lean_lib`, no Challenge/Solution pair
+and no Comparator suite. Check it with `lake env lean Exploratory/V2a/GramEntry.lean`.
+
+The entry is `I_T[(1, ∅), (0, (2))] = ∫_{T̃} (L − P₁) P₂ dx` over the rescaled support
+`T̃ = {x ∈ [0, ∞)⁴⁵ : P₁ ≤ L, R_g(x) ≤ C(s(x))}` (Lemma 9.1, Table 3 caps). By symmetry,
+`∫ (L − P₁) P₂ = 45 L m(2) − 45 m(3) − 45·44 m(2,1)` with `m(α) = ∫_{T̃} ∏ xᵢ^{αᵢ}`.
+
+`moment N α` is Proposition 10.2's decomposition made explicit, as a rational number:
+* rough set `R`, `|R| = r` (stratum), shift `xᵢ = g + zᵢ` on `R`;
+* inclusion–exclusion over `K`, `|K| = k`, for the smooth bounds `xⱼ ≤ g`, shift `xⱼ = g + wⱼ`;
+* each piece `{z ≥ 0, (w, y) ≥ 0 : Σz ≤ C(r) − rg, Σz + Σw + Σy ≤ L − (r + k) g}` integrates a
+  monomial by (10.1) applied to each group (Dirichlet form) and the one-variable integral
+  `incBeta c M p q = ∫₀^c u^p (M − u)^q du`;
+* the coordinates of `α` are assigned to the groups (rough / in `K` / smooth); binomial
+  multiplicities count the remaining coordinates.
+
+What the kernel checks here: the arithmetic of the decomposition (`moment_*`, `entry_45`), and
+two controls in dimension 2 against an independent exact polygon integration
+(`Exploratory/V2a/cross_checks.py`). What remains for V2 proper: the measure-theoretic proof that
+the decomposition equals the integral (stratification, inclusion–exclusion, Dirichlet). -/
+
+namespace BGP212.V2a
+
+open BGP212.Params
+
+/-- `n choose k` through factorials (linear-time in the kernel). -/
+def chooseF (n k : ℕ) : ℕ :=
+  if k ≤ n then n.factorial / (k.factorial * (n - k).factorial) else 0
+
+/-- `∫₀^c u^p (M − u)^q du`, expanded binomially. -/
+def incBeta (c M : ℚ) (p q : ℕ) : ℚ :=
+  (List.range (q + 1)).foldl
+    (fun acc j => acc + (chooseF q j : ℚ) * M ^ (q - j) * (-1) ^ j * c ^ (p + j + 1) / (p + j + 1)) 0
+
+/-- The nonempty pieces `(r, k, c_r, M)` with `r` rough coordinates, in dimension `N`. -/
+def piecesRow (N r : ℕ) : List (ℕ × ℕ × ℚ × ℚ) :=
+  let cr : ℚ := C r - (r : ℚ) * g
+  if 0 < r ∧ cr ≤ 0 then [] else
+    (List.range (N - r + 1)).filterMap fun k : ℕ =>
+      let M : ℚ := L - ((r + k : ℕ) : ℚ) * g
+      if M ≤ 0 then none else some (r, k, cr, M)
+
+/-- All nonempty pieces in dimension `N`. -/
+def pieces (N : ℕ) : List (ℕ × ℕ × ℚ × ℚ) :=
+  (List.range (N + 1)).flatMap (piecesRow N)
+
+/-- A partial assignment: coordinates sent to the rough group (`nA`) and to `K` (`nB`), the
+exponent totals on the `z` group (`sa`) and on the `(w, y)` group (`sb`), and the weight. -/
+structure Acc where
+  nA : ℕ
+  nB : ℕ
+  sa : ℕ
+  sb : ℕ
+  w : ℚ
+
+/-- Assign each exponent to a group, expanding `(g + ·)^e` on shifted coordinates. -/
+def expand (r k : ℕ) : List ℕ → List Acc
+  | [] => [⟨0, 0, 0, 0, 1⟩]
+  | e :: es => (expand r k es).flatMap fun s =>
+      [⟨s.nA, s.nB, s.sa, s.sb + e, s.w * e.factorial⟩] ++
+      (if s.nA < r then (List.range (e + 1)).map fun t =>
+          ⟨s.nA + 1, s.nB, s.sa + t, s.sb, s.w * chooseF e t * g ^ (e - t) * t.factorial⟩ else []) ++
+      (if s.nB < k then (List.range (e + 1)).map fun t =>
+          ⟨s.nA, s.nB + 1, s.sa, s.sb + t, s.w * chooseF e t * g ^ (e - t) * t.factorial⟩ else [])
+
+/-- The signed, counted contribution of one assignment on one piece. -/
+def pieceTerm (N d r k : ℕ) (cr M : ℚ) (s : Acc) : ℚ :=
+  let n := N - r
+  let nC := d - s.nA - s.nB
+  if N - d < r - s.nA ∨ n < s.nB + nC then 0 else
+    let mult : ℚ := chooseF (N - d) (r - s.nA) * chooseF (N - d - (r - s.nA)) (k - s.nB)
+    let val : ℚ :=
+      if n = 0 then
+        s.w / (r - 1 + s.sa).factorial * (min cr M) ^ (r + s.sa) / (r + s.sa)
+      else if r = 0 then
+        s.w / (n - 1 + s.sb).factorial * M ^ (n + s.sb) / (n + s.sb)
+      else
+        s.w / (r - 1 + s.sa).factorial / (n - 1 + s.sb).factorial *
+          incBeta (min cr M) M (r - 1 + s.sa) (n + s.sb) / (n + s.sb)
+    (-1) ^ k * mult * val
+
+/-- The contribution of the strata with `r` rough coordinates to `m(α)`. -/
+def momentRow (N : ℕ) (α : List ℕ) (r : ℕ) : ℚ :=
+  (piecesRow N r).foldl (fun acc pc =>
+    let (r, k, cr, M) := pc
+    (expand r k α).foldl (fun acc' s => acc' + pieceTerm N α.length r k cr M s) acc) 0
+
+/-- `m(α) = ∫_{T̃} ∏ xᵢ^{αᵢ}` in dimension `N` (support of `α` = its first coordinates),
+by Proposition 10.2's decomposition, summed over the number `r` of rough coordinates. -/
+def moment (N : ℕ) (α : List ℕ) : ℚ :=
+  ∑ r ∈ Finset.range (N + 1), momentRow N α r
+
+/-- `I_T[(1, ∅), (0, (2))] = ∫_{T̃} (L − P₁) P₂` in dimension `N`. -/
+def entry (N : ℕ) : ℚ :=
+  L * N * moment N [2] - (N * moment N [3] + N * (N - 1) * moment N [2, 1])
+
