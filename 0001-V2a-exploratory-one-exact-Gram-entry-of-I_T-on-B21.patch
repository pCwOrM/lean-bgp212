+#!/usr/bin/env python3
+"""Emit Exploratory/V2a/GramEntry.lean: the definitions (GramEntry.head.lean) plus one
+kernel-checked row lemma per (moment, r), assembled into the moments and the Gram entry.
+Row lemmas keep each kernel evaluation small (the undivided evaluation exceeds 8 GB)."""
+from fractions import Fraction as Fr
+import os
+import gram_entry as G
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+MOMENTS = {"vol": [], "m2": [2], "m3": [3], "m21": [2, 1]}
+
+
+def rows(N, alpha):
+    terms = []
+    G.moment(N, tuple(alpha), terms)
+    out = [Fr(0)] * (N + 1)
+    for t in terms:
+        out[t["r"]] += Fr(t["value"])
+    return out
+
+
+def q(x):
+    x = Fr(x)
+    if x.denominator == 1:
+        return f"({x.numerator} : ℚ)"
+    return f"({x.numerator} / {x.denominator} : ℚ)"
+
+
+def lst(alpha):
+    return "[" + ", ".join(map(str, alpha)) + "]"
+
+
+def emit_moment(N, name, alpha):
+    rs = rows(N, alpha)
+    total = sum(rs)
+    lines = []
+    names = []
+    for r, v in enumerate(rs):
+        nm = f"row_{name}_{N}_{r}"
+        names.append(nm)
+        lines.append(f"theorem {nm} : momentRow {N} {lst(alpha)} {r} = {q(v)} := by decide +kernel\n")
+    lines.append(f"theorem {name}_{N} : moment {N} {lst(alpha)} = {q(total)} := by\n"
+                 f"  simp only [moment, Finset.sum_range_succ, Finset.sum_range_zero,\n    "
+                 + ", ".join(names) + "]\n  norm_num\n")
+    return "\n".join(lines), total
+
+
+def main():
+    head = open(os.path.join(HERE, "GramEntry.head.lean")).read()
+    out = [head, "/-! ## Controls in dimension 2 (an independent exact polygon integration agrees;\n"
+                 "see `cross_checks.py`) -/\n"]
+    vals = {}
+    for N in (2, 45):
+        if N == 45:
+            out.append("/-! ## Dimension 45: one lemma per number `r` of rough coordinates -/\n")
+        for name, alpha in MOMENTS.items():
+            text, total = emit_moment(N, name, alpha)
+            out.append(text)
+            vals[(N, name)] = total
+        e, _ = G.entry_LmP1_P2(N)
+        assert e == G.L * N * vals[(N, "m2")] - (N * vals[(N, "m3")] + N * (N - 1) * vals[(N, "m21")])
+        doc = ("/-- **The Gram entry** `I_T[(1, ∅), (0, (2))] = ∫_{T̃} (L − P₁) P₂`, exactly. -/\n"
+               if N == 45 else "/-- The same entry in dimension 2 (control). -/\n")
+        out.append(doc + f"theorem entry_{N} : entry {N} = {q(e)} := by\n"
+                   f"  rw [entry, m2_{N}, m3_{N}, m21_{N}]\n  norm_num [L]\n")
+    out.append("end BGP212.V2a\n")
+    out.append("#print axioms BGP212.V2a.entry_45\n")
+    open(os.path.join(HERE, "GramEntry.lean"), "w").write("\n".join(out))
+    e45, _ = G.entry_LmP1_P2(45)
+    print("entry_45 =", e45.numerator, "/", e45.denominator)
+    print("≈", float(e45))
+
+
+if __name__ == "__main__":
+    main()
