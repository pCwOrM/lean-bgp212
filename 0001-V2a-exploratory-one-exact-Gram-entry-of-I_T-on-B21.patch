+#!/usr/bin/env python3
+"""V2a (exploratory): exact Gram-matrix entries of I_T on B21 via Proposition 10.2.
+
+Rescaled support (Lemma 9.1, Table 3 caps):
+    T~ = {x in [0,oo)^N : P1(x) <= L, R_g(x) <= C(s(x))},
+    L = 53/50, g = 41/625, C(0) = 0, C(m) = 4 B_{1,m}.
+
+Decomposition (Proposition 10.2, made explicit):
+  * stratum = rough set R (|R| = r): x_i = g + z_i (i in R), 0 <= x_j <= g (j not in R);
+  * smooth upper bounds x_j <= g by inclusion-exclusion over K (|K| = k): x_j = g + w_j (j in K);
+  * the piece is {z >= 0 (r vars), (w, y) >= 0 (n = N - r vars) : sum z <= c_r, sum z + sum w + sum y <= M}
+    with c_r = C(r) - r g and M = L - (r + k) g, sign (-1)^k;
+  * a monomial z^a w^b y^c integrates (Dirichlet / (10.1) twice) to
+        prod a! / (r-1+|a|)!  *  prod b! prod c! / (n-1+|b|+|c|)!  *  int_0^{min(c_r,M)} u^p (M-u)^(q+1)/(q+1) du,
+    p = r-1+|a|, q = n-1+|b|+|c|   (r = 0: the z-factor is absent and the integral is M^(q+1)/(q+1)).
+
+Symmetry: the integral of x^alpha depends only on the multiset of exponents; each piece type
+(r, k, and how the support of alpha meets the three groups) carries a binomial multiplicity.
+"""
+from fractions import Fraction as Fr
+from itertools import product
+from math import comb, factorial
+import json, sys
+
+L = Fr(53, 50)
+g = Fr(41, 625)
+BNUM = [777, 794, 875, 917, 953, 983, 1016, 1042, 1063, 1081]
+
+
+def C(m):
+    if m == 0:
+        return Fr(0)
+    return Fr(4 * BNUM[min(m, 10) - 1], 5000)
+
+
+def inc_beta(c, M, p, q1):
+    """int_0^c u^p (M - u)^q1 du, exact (binomial expansion)."""
+    return sum(comb(q1, j) * M ** (q1 - j) * (-1) ** j * c ** (p + j + 1) / (p + j + 1)
+               for j in range(q1 + 1))
+
+
+def pieces(N):
+    """(r, k, c_r, M) for the nonempty pieces."""
+    out = []
+    for r in range(N + 1):
+        cr = C(r) - r * g
+        if r > 0 and cr <= 0:
+            continue
+        for k in range(N - r + 1):
+            M = L - (r + k) * g
+            if M <= 0:
+                continue
+            out.append((r, k, cr, M))
+    return out
+
+
+def piece_monomial(r, n, cr, M, a, bc):
+    """Integral of z^a (w,y)^bc over the piece (a: exponents on z group, bc: on w/y group)."""
+    if n == 0:  # every coordinate rough: only the z-simplex of radius min(c_r, M)
+        assert not bc and r > 0
+        p = r - 1 + sum(a)
+        Da = Fr(1)
+        for e in a:
+            Da *= factorial(e)
+        Da /= factorial(p)
+        R = min(cr, M)
+        return Da * R ** (p + 1) / (p + 1)
+    sb = sum(bc)
+    q = n - 1 + sb
+    Dn = Fr(1)
+    for e in bc:
+        Dn *= factorial(e)
+    Dn /= factorial(q)
+    if r == 0:
+        assert not a
+        return Dn * M ** (q + 1) / (q + 1)
+    sa = sum(a)
+    p = r - 1 + sa
+    Da = Fr(1)
+    for e in a:
+        Da *= factorial(e)
+    Da /= factorial(p)
+    return Da * Dn * inc_beta(min(cr, M), M, p, q + 1) / (q + 1)
+
+
+def moment(N, alpha, terms=None):
+    """int_{T~} prod_{i<d} x_i^alpha_i in dimension N (support of alpha = first d coordinates)."""
+    d = len(alpha)
+    total = Fr(0)
+    for (r, k, cr, M) in pieces(N):
+        n = N - r
+        for assign in product("ABC", repeat=d):
+            dA, dB = assign.count("A"), assign.count("B")
+            if dA > r or dB > k or r - dA > N - d:
+                continue
+            mult = comb(N - d, r - dA) * comb(N - d - (r - dA), k - dB)
+            if mult == 0:
+                continue
+            # expand (g + .)^e on A and B coordinates
+            choices = []
+            for e, grp in zip(alpha, assign):
+                if grp == "C":
+                    choices.append([(Fr(1), e, grp)])
+                else:
+                    choices.append([(comb(e, t) * g ** (e - t), t, grp) for t in range(e + 1)])
+            val = Fr(0)
+            for combo in product(*choices):
+                coef = Fr(1)
+                a, bc = [], []
+                for (cf, t, grp) in combo:
+                    coef *= cf
+                    (a if grp == "A" else bc).append(t)
+                val += coef * piece_monomial(r, n, cr, M, a, bc)
+            term = (-1) ** k * mult * val
+            if terms is not None:
+                terms.append({"r": r, "k": k, "assign": "".join(assign), "mult": mult,
+                              "value": str(term)})
+            total += term
+    return total
+
+
+def entry_LmP1_P2(N):
+    """I_T[(a=1, lam=()), (a=0, lam=(2))] = int (L - P1) P2 over T~ in dimension N."""
+    m2 = moment(N, (2,))
+    m3 = moment(N, (3,))
+    m21 = moment(N, (2, 1))
+    return L * N * m2 - (N * m3 + N * (N - 1) * m21), {"m2": m2, "m3": m3, "m21": m21}
+
+
+def volume(N):
+    return moment(N, ())
+
+
+if __name__ == "__main__":
+    N = int(sys.argv[1]) if len(sys.argv) > 1 else 45
+    vol = volume(N)
+    e, ms = entry_LmP1_P2(N)
+    print("N", N, "pieces", len(pieces(N)))
+    print("vol", float(vol))
+    for kname, v in ms.items():
+        print(kname, float(v))
+    print("entry", float(e))
+    print("entry digits num/den", len(str(e.numerator)), len(str(e.denominator)))
+
+
+def moment_dp(N, alpha):
+    """Same value as moment(N, alpha), by dynamic programming over the parts of alpha.
+
+    Each part chooses a group (A rough, B smooth-in-K, C smooth) and, on A/B, an expansion
+    exponent t of (g + .)^e; only (#A, #B, |a|, |b|+|c|) and the product of the per-part
+    weights binom(e,t) g^(e-t) t! enter the Dirichlet formula."""
+    d = len(alpha)
+    total = Fr(0)
+    for (r, k, cr, M) in pieces(N):
+        n = N - r
+        states = {(0, 0, 0, 0): Fr(1)}
+        for e in alpha:
+            new = {}
+            for (nA, nB, sa, sb), w in states.items():
+                # C: exponent e on an unshifted coordinate
+                key = (nA, nB, sa, sb + e)
+                new[key] = new.get(key, 0) + w * factorial(e)
+                for t in range(e + 1):
+                    wt = w * comb(e, t) * g ** (e - t) * factorial(t)
+                    if nA < r:
+                        key = (nA + 1, nB, sa + t, sb)
+                        new[key] = new.get(key, 0) + wt
+                    if nB < k:
+                        key = (nA, nB + 1, sa, sb + t)
+                        new[key] = new.get(key, 0) + wt
+            states = new
+        for (nA, nB, sa, sb), w in states.items():
+            if r - nA > N - d:
+                continue
+            nC = d - nA - nB
+            if nB + nC > n:
+                continue
+            mult = comb(N - d, r - nA) * comb(N - d - (r - nA), k - nB)
+            if mult == 0:
+                continue
+            if n == 0:
+                p = r - 1 + sa
+                R = min(cr, M)
+                val = w / factorial(p) * R ** (p + 1) / (p + 1)
+            elif r == 0:
+                q = n - 1 + sb
+                val = w / factorial(q) * M ** (q + 1) / (q + 1)
+            else:
+                p, q = r - 1 + sa, n - 1 + sb
+                val = w / factorial(p) / factorial(q) * inc_beta(min(cr, M), M, p, q + 1) / (q + 1)
+            total += (-1) ** k * mult * val
+    return total
