+#!/usr/bin/env python3
+"""Emit Solution/GramGeneralCert.lean: the kernel certificate for V2c's worked example.
+
+The worked example is the Gram entry
+    I_T[(1, (2)), (0, (2))] = ∫_{T̃} (L − P₁) P₂² = 45 · F4 + 1980 · F22,
+    F4  = gramFin 45 1 g L C ![4] 1      (∫ (L − Σx) x₀⁴),
+    F22 = gramFin 45 2 g L C ![2, 2] 1   (∫ (L − Σx) x₀² x₁²),
+at Table 3 (BGP212.Params). The closed form `gramFin` (BGP212/GramGeneral.lean) is mirrored here in
+exact rational arithmetic (standard library only). Each cell `finCell … r A B` (row r, placement
+(A, B) of the distinguished coordinates) is one `decide +kernel` lemma, so that each kernel
+evaluation stays below about 1.5 GB above the import baseline; rows and totals are assembled by
+`norm_num`.
+
+Usage: python3 -I specs/checks/gram_general_v2c_emit.py [output path]
+"""
+import itertools
+import sys
+from fractions import Fraction as Fr
+from math import comb, factorial as fact, prod
+
+L = Fr(53, 50)
+G = Fr(41, 625)
+BNUM = [777, 794, 875, 917, 953, 983, 1016, 1042, 1063, 1081]
+N, P = 45, 1
+
+
+def C(m):
+    if m == 0:
+        return Fr(0)
+    return 4 * Fr(BNUM[min(m, 10) - 1], 5000)
+
+
+def two_group_w(n, r, A, B, p, W, c, M):
+    if not (c >= 0 and M >= 0):
+        return Fr(0)
+    q = n + B + p
+    cp = min(c, M)
+    return W * Fr(fact(p), fact(q)) * sum(
+        comb(q, j) * (M - cp) ** (q - j) * cp ** (r + A + j) * Fr(fact(j), fact(r + A + j))
+        for j in range(q + 1))
+
+
+def phi_fin(es, A, B, rho, kap):
+    d = len(es)
+    tot = Fr(0)
+    for t in itertools.product(*[range(e + 1) for e in es]):
+        coef = prod(comb(es[j], t[j]) * (G if (j in A or j in B) else Fr(0)) ** (es[j] - t[j])
+                    for j in range(d))
+        if coef == 0:
+            continue
+        a = sum(t[j] for j in A)
+        b = sum(t[j] for j in range(d) if j not in A)
+        W = prod(fact(x) for x in t)
+        tot += coef * two_group_w(N - rho, rho, a, b, P, W, C(rho) - rho * G, L - (rho + kap) * G)
+    return tot
+
+
+def fin_cell(es, r, A, B):
+    d = len(es)
+    s = sum(comb(N - d - r, k) * (-1) ** k * phi_fin(es, A, B, len(A) + r, len(B) + k)
+            for k in range(N - d - r + 1))
+    return (-1) ** len(B) * comb(N - d, r) * s
+
+
+def lit(x):
+    x = Fr(x)
+    if x.denominator == 1:
+        return f"({x.numerator} : ℚ)"
+    return f"({x.numerator} / {x.denominator} : ℚ)"
+
+
+def fs(S):
+    return "∅" if not S else "{" + ", ".join(str(j) for j in sorted(S)) + "}"
+
+
+# cell order exactly as produced by `finRow_one` / `finRow_two`
+CELLS = {
+    1: [(set(), set()), (set(), {0}), ({0}, set())],
+    2: [(set(), set()), (set(), {0}), (set(), {1}), (set(), {0, 1}),
+        ({0}, set()), ({0}, {1}), ({1}, set()), ({1}, {0}), ({0, 1}, set())],
+}
+
+HEADER = '''/-
+Copyright (c) 2026 thinkthoughts. All rights reserved.
+Released under MIT license as described in the file LICENSE.
+Source: Axiom Math, "A New Bound for Small Gaps Between Primes", preliminary draft
+(September 3, 2026): Table 3 (p. 39), Proposition 10.2 (p. 42), §11 (p. 42).
+-/
+import BGP212.GramGeneral
+
+/-! # V2c: the kernel certificate for the worked example
+
+COMPUTATIONAL CERTIFICATE (generated by `specs/checks/gram_general_v2c_emit.py`). The closed
+forms `gramFin 45 1 g L C ![4] 1` and `gramFin 45 2 g L C ![2, 2] 1` (Table 3 data from
+`BGP212.Params`) are evaluated over `ℚ` by the Lean kernel, one `decide +kernel` lemma per cell
+(row `r`, placement `(A, B)`), and assembled by `norm_num`. The integral identities that give
+these numbers their meaning are proved in `Solution/GramGeneral.lean`. -/
+
+namespace BGP212.Gram
+
+open BGP212.Params
+
+variable {K : Type*} [Field K] [LinearOrder K]
+
+/-- A row of `gramFin` with one distinguished coordinate, cell by cell. -/
+theorem finRow_one (N : ℕ) (g L : K) (C : ℕ → K) (es : Fin 1 → ℕ) (p r : ℕ) :
+    finRow N 1 g L C es p r =
+      finCell N 1 g L C es p r ∅ ∅ + finCell N 1 g L C es p r ∅ {0} +
+        finCell N 1 g L C es p r {0} ∅ := by
+  unfold finRow
+  rw [show (Finset.univ : Finset (Fin 1)).powerset = {∅, {0}} from by decide,
+    Finset.sum_insert (by decide), Finset.sum_singleton,
+    show (Finset.univ : Finset (Fin 1)) \\ ∅ = {0} from by decide,
+    show (Finset.univ : Finset (Fin 1)) \\ {0} = ∅ from by decide,
+    show ({0} : Finset (Fin 1)).powerset = {∅, {0}} from by decide, Finset.powerset_empty,
+    Finset.sum_insert (by decide), Finset.sum_singleton, Finset.sum_singleton]
+  all_goals ring
+
+/-- A row of `gramFin` with two distinguished coordinates, cell by cell. -/
+theorem finRow_two (N : ℕ) (g L : K) (C : ℕ → K) (es : Fin 2 → ℕ) (p r : ℕ) :
+    finRow N 2 g L C es p r =
+      finCell N 2 g L C es p r ∅ ∅ + finCell N 2 g L C es p r ∅ {0} +
+        finCell N 2 g L C es p r ∅ {1} + finCell N 2 g L C es p r ∅ {0, 1} +
+        finCell N 2 g L C es p r {0} ∅ + finCell N 2 g L C es p r {0} {1} +
+        finCell N 2 g L C es p r {1} ∅ + finCell N 2 g L C es p r {1} {0} +
+        finCell N 2 g L C es p r {0, 1} ∅ := by
+  unfold finRow
+  rw [show (Finset.univ : Finset (Fin 2)).powerset = {∅, {0}, {1}, {0, 1}} from by decide,
+    Finset.sum_insert (by decide), Finset.sum_insert (by decide), Finset.sum_insert (by decide),
+    Finset.sum_singleton,
+    show (Finset.univ : Finset (Fin 2)) \\ ∅ = {0, 1} from by decide,
+    show (Finset.univ : Finset (Fin 2)) \\ {0} = {1} from by decide,
+    show (Finset.univ : Finset (Fin 2)) \\ {1} = {0} from by decide,
+    show (Finset.univ : Finset (Fin 2)) \\ {0, 1} = ∅ from by decide,
+    show ({0, 1} : Finset (Fin 2)).powerset = {∅, {0}, {1}, {0, 1}} from by decide,
+    show ({1} : Finset (Fin 2)).powerset = {∅, {1}} from by decide,
+    show ({0} : Finset (Fin 2)).powerset = {∅, {0}} from by decide, Finset.powerset_empty,
+    Finset.sum_insert (by decide), Finset.sum_insert (by decide), Finset.sum_insert (by decide),
+    Finset.sum_singleton, Finset.sum_insert (by decide), Finset.sum_singleton,
+    Finset.sum_insert (by decide), Finset.sum_singleton, Finset.sum_singleton]
+  all_goals ring
+'''
+
+
+def emit_formula(name, es, lines):
+    d = len(es)
+    esl = "![" + ", ".join(map(str, es)) + "]"
+    rowvals = []
+    rownames = []
+    for r in range(N - d + 1):
+        cellnames = []
+        rv = Fr(0)
+        for (A, B) in CELLS[d]:
+            v = fin_cell(es, r, A, B)
+            rv += v
+            cn = f"cell_{name}_{r}_{''.join(map(str, sorted(A))) or 'e'}_{''.join(map(str, sorted(B))) or 'e'}"
+            cellnames.append(cn)
+            lines.append(f"theorem {cn} : finCell 45 {d} g L C {esl} 1 {r} {fs(A)} {fs(B)} = "
+                         f"{lit(v)} := by decide +kernel\n")
+        rn = f"row_{name}_{r}"
+        rownames.append(rn)
+        rowvals.append(rv)
+        two = "finRow_one" if d == 1 else "finRow_two"
+        lines.append(f"theorem {rn} : finRow 45 {d} g L C {esl} 1 {r} = {lit(rv)} := by\n"
+                     f"  rw [{two}, {', '.join(cellnames)}]\n  norm_num\n")
+    total = sum(rowvals)
+    lines.append(f"theorem gramFin_{name} : gramFin 45 {d} g L C {esl} 1 = {lit(total)} := by\n"
+                 f"  rw [gramFin, show 45 - {d} + 1 = {N - d + 1} from rfl]\n"
+                 "  simp only [Finset.sum_range_succ, Finset.sum_range_zero, "
+                 + ", ".join(rownames) + "]\n  norm_num\n")
+    return total
+
+
+def main():
+    out = sys.argv[1] if len(sys.argv) > 1 else "Solution/GramGeneralCert.lean"
+    lines = [HEADER]
+    f4 = emit_formula("F4", [4], lines)
+    f22 = emit_formula("F22", [2, 2], lines)
+    entry = 45 * f4 + 1980 * f22
+    lines.append("/-- **The worked example** `I_T[(1, (2)), (0, (2))]` as a rational. -/\n"
+                 f"theorem gramExampleQ_eq : gramExampleQ = {lit(entry)} := by\n"
+                 "  rw [gramExampleQ, gramFin_F4, gramFin_F22]\n  norm_num\n")
+    lines.append("end BGP212.Gram\n")
+    open(out, "w").write("\n".join(lines))
+    print("F4  =", float(f4))
+    print("F22 =", float(f22))
+    print("gramExampleQ =", entry.numerator, "/", entry.denominator)
+    print("≈", float(entry))
+
+
+if __name__ == "__main__":
+    main()
