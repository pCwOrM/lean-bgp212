+Released under MIT license as described in the file LICENSE.
+Source: Axiom Math, "A New Bound for Small Gaps Between Primes", preliminary draft
+(September 3, 2026): Definition 4.1 (p. 4), Lemma 7.10 (p. 36), Table 3 and §9.1 (p. 39),
+§9.3 dictionary and Lemma 9.1 with its proof (pp. 40–41), Lemma 9.2 (p. 41).
+-/
+import BGP212.Params
+
+/-! # V2a (exploratory): the two cap sequences of §9
+
+The proof of Lemma 9.1 says the dilation "sends the two physical rough caps to
+`C(1) = C(2) = 31/50` and `C(s) = 17/25` for `s ≥ 3`". Undoing the dilation by 4, these are
+the physical caps `B'₁ = B'₂ = 31/200`, `B'ₘ = 17/100` (`m ≥ 3`): a two-level datum, `twoCap`.
+Table 3 (and `BGP212.Params.B`) carries the ten-rung sequence.
+
+Every statement below is decided by the kernel over `m ≤ ⌊1/δ⌋ = 60`, the full column range of
+Definition 4.1's matrix `B`. -/
+
+namespace BGP212.V2a.Caps
+
+open BGP212.Params
+
+/-- The physical two-level cap datum read off from the proof of Lemma 9.1. -/
+def twoCap (m : Nat) : Rat :=
+  if m = 0 then 0 else if m ≤ 2 then 31 / 200 else 17 / 100
+
+/-- `⌊1/δ⌋ = 60`. -/
+theorem floor_inv_delta : (2500 / 41 : Nat) = 60 := by decide
+
+/-- The numbers printed in Lemma 9.1's proof are exactly the dilation of `twoCap`. -/
+theorem lemma_9_1_proof_numbers :
+    4 * twoCap 1 = 31 / 50 ∧ 4 * twoCap 2 = 31 / 50 ∧ ∀ m ∈ List.range' 3 58, 4 * twoCap m = 17 / 25 := by
+  decide +kernel
+
+/-- Table 3's rescaled caps differ from them at every rough count `s ≥ 1`. -/
+theorem table3_differs : ∀ m ∈ List.range' 1 60, C m ≠ 4 * twoCap m := by decide +kernel
+
+/-- Definition 4.1's conditions `δ < B_m ≤ B_{m+1} ≤ B_m + δ` hold for **both** data. -/
+theorem def41_table3 : ∀ m ∈ List.range' 1 59, δ < B m ∧ B m ≤ B (m + 1) ∧ B (m + 1) ≤ B m + δ := by
+  decide +kernel
+
+theorem def41_twoCap :
+    ∀ m ∈ List.range' 1 59, δ < twoCap m ∧ twoCap m ≤ twoCap (m + 1) ∧ twoCap (m + 1) ≤ twoCap m + δ := by
+  decide +kernel
+
+/-- The two-cap datum lies below Table 3 at every rough count, so its support is contained in
+Table 3's support (same band `A`, smaller rough-mass caps). -/
+theorem twoCap_le_table3 : ∀ m ∈ List.range 61, twoCap m ≤ B m := by decide +kernel
+
+/-- Strict at every `m ≥ 1`: the containment is proper. -/
+theorem twoCap_lt_table3 : ∀ m ∈ List.range' 1 60, twoCap m < B m := by decide +kernel
+
+/-- Largest feasible rough count (`m δ ≤ B_m`): 13 for Table 3 (Lemma 7.10 ranges over
+`m, m′ ≤ 13`), 10 for the two-cap datum. -/
+theorem max_rough_table3 : 13 * δ ≤ B 13 ∧ ∀ m ∈ List.range' 14 47, B m < m * δ := by decide +kernel
+
+theorem max_rough_twoCap : 10 * δ ≤ twoCap 10 ∧ ∀ m ∈ List.range' 11 50, twoCap m < m * δ := by
+  decide +kernel
+
+/-- Lemma 9.2's fiber formula needs every cap step below `g` (equivalently `B_{m+1} − B_m < δ`);
+both data satisfy it. Table 3's tightest step is `m = 2 → 3`: `81/5000 < 82/5000`. -/
+theorem step_lt_delta_table3 : ∀ m ∈ List.range' 1 59, B (m + 1) - B m < δ := by decide +kernel
+
+theorem step_lt_delta_twoCap : ∀ m ∈ List.range' 1 59, twoCap (m + 1) - twoCap m < δ := by
+  decide +kernel
+
+theorem tightest_step : B 3 - B 2 = 81 / 5000 ∧ δ = 82 / 5000 := by decide +kernel
+
