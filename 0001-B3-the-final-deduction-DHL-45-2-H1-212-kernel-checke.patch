+Source: Axiom Math, "A New Bound for Small Gaps Between Primes", preliminary draft
+(September 3, 2026): §2 (admissibility, DHL[k, m], H₁), Definition 4.1, Definition 4.5
+and Lemma 4.9 (the W-trick), Theorem 4.10, Theorem 11.1 and §9.3, Lemma 12.1 and the
+proof of Theorem 1.1 (§12).
+-/
+import BGP212.Basic
+import BGP212.WTrick
+import BGP212.Theorem711
+import Mathlib.Data.Nat.Nth
+import Mathlib.NumberTheory.Primorial
+import Mathlib.Order.LiminfLimsup
+import Mathlib.Data.Real.Basic
+
+/-! # B3: the final deduction
+
+Track B (Mathlib). The objects of the last step of the paper:
+
+* `AdmissibleZ`, `DHL`: §2, "for every admissible k-tuple H, there are infinitely many
+  integers n such that at least m of n + h₁, …, n + h_k are prime".
+* `primeGap`, `H1Le`: `H₁ = liminf (p_{n+1} − p_n)`; `H1Le D` says `p_{n+1} − p_n ≤ D` for
+  infinitely many `n`, which for a sequence of naturals is `liminf ≤ D` (`h1_liminf`).
+* `StadlmannSupport`: the datum of Definition 4.1 (rational, as §2 fixes), its constraints
+  (`Valid`, A4's `SupportDatum`), and the set `T_k` itself (`supportSet`).
+* `SieveInputs`: Theorem 4.10 and its two inputs as named hypotheses. The distribution input
+  is tied to A4: `equidistributed_of_coverage` takes exactly the two conclusions of
+  `theorem_7_11`. -/
+
+namespace BGP212.Gap
+
+open BGP212.Params BGP212.T711 Filter
+
+/-! ## §2: admissibility, DHL, H₁ -/
+
+/-- An integer is prime: a positive integer whose value is a prime natural. -/
+def PrimeZ (z : ℤ) : Prop := 0 < z ∧ z.toNat.Prime
+
+instance : DecidablePred PrimeZ := fun z => inferInstanceAs (Decidable (0 < z ∧ z.toNat.Prime))
+
+/-- §2: a finite set of distinct integers omitting at least one residue class modulo every
+prime. -/
+def AdmissibleZ (H : Finset ℤ) : Prop :=
+  ∀ p : ℕ, p.Prime → ∃ r : ℤ, ∀ h ∈ H, ¬ ((p : ℤ) ∣ h - r)
+
+/-- **DHL[k, m]** (§2): for every admissible `k`-tuple `H` there are infinitely many integers
+`n` such that at least `m` of the `n + h` (`h ∈ H`) are prime. -/
+def DHL (k m : ℕ) : Prop :=
+  ∀ H : Finset ℤ, H.card = k → AdmissibleZ H →
+    {n : ℤ | m ≤ (H.filter fun h => PrimeZ (n + h)).card}.Infinite
+
+/-- `p_{n+1} − p_n`, with `p_0 = 2` the first prime. -/
+noncomputable def primeGap (n : ℕ) : ℕ := Nat.nth Nat.Prime (n + 1) - Nat.nth Nat.Prime n
+
+/-- **`H₁ ≤ D`**: infinitely many consecutive primes differ by at most `D`. -/
+def H1Le (D : ℕ) : Prop := ∃ᶠ n in atTop, primeGap n ≤ D
+
+/-! ## Definition 4.1: the Stadlmann support -/
+
+/-- The datum of Definition 4.1: `k` shifts, `n` bands, `δ`, `ε`, `A = (A₀, …, A_n)`, and the
+caps `B_{j,m}`. -/
+structure StadlmannSupport where
+  k : ℕ
+  n : ℕ
+  δ : ℚ
+  ε : ℚ
+  A : ℕ → ℚ
+  B : ℕ → ℕ → ℚ
+
+namespace StadlmannSupport
+
+/-- Definition 4.1's constraints on the datum (A4's `SupportDatum`), with `k ≥ 1`. -/
+def Valid (T : StadlmannSupport) : Prop := 0 < T.k ∧ SupportDatum T.n T.A T.B T.δ T.ε
+
+/-- **Definition 4.1**: `T_k(δ, A, B, ε)`, the union over bands `j` of the points
+`t ∈ [0, 1]^k` with `A_{j−1} + ε ≤ S(t) < A_j + ε` and `M_δ(t) ≤ B_{j, |R_δ(t)|}`. -/
+def supportSet (T : StadlmannSupport) : Set (Fin T.k → ℝ) :=
+  {t | (∀ i, 0 ≤ t i ∧ t i ≤ 1) ∧ ∃ j, 1 ≤ j ∧ j ≤ T.n ∧
+    ((T.A (j - 1) + T.ε : ℚ) : ℝ) ≤ ∑ i, t i ∧ ∑ i, t i < ((T.A j + T.ε : ℚ) : ℝ) ∧
+    ∑ i ∈ Finset.univ.filter (fun i => (T.δ : ℝ) < t i), t i ≤
+      ((T.B j (Finset.univ.filter (fun i => (T.δ : ℝ) < t i)).card : ℚ) : ℝ)}
+
+end StadlmannSupport
+
+/-- Table 3's support: `k = 45`, one band, `δ = 41/2500`, `ε = εₛ = 1/125`. -/
+def table3Support : StadlmannSupport := ⟨45, 1, δ, εs, A3, B3⟩
+
+/-! ## Theorem 4.10 and its inputs -/
+
+/-- **The sieve criterion and its inputs, as named hypotheses** (outside the proved scope).
+
+* `Equidistributed T`: Definition 4.4 for `ρ = 1_P` — `1_P` is equidistributed for the moduli
+  generated by `T` (the bound (4.7) for every `A > 0`, `ε₀ > 0`, uniformly in primitive
+  residue classes).
+* `VariationalIneq T`: Theorem 4.10's variational hypothesis — some nonzero symmetric
+  `F ∈ L²(T_k)` satisfies `k·J_T(F) > I_T(F)` (Definition 4.6).
+* `theorem_4_10`: the direct-prime sieve criterion (Proposition 4.7 at `ρ = 1_P`,
+  `c₁ = c₂ = 0`, through Proposition 4.8 and Lemma 4.9).
+* `theorem_11_1`: Theorem 11.1 with the §9.3 rescaling, in Theorem 4.10's physical form.
+* `equidistributed_of_coverage`: the distribution input at Table 3 from the two conclusions
+  of Theorem 7.11 (`A.PositiveLevel`, `A.HalfLevel`, which A4's `theorem_7_11` proves from
+  `A`): Theorem 8.3's absolute discrepancy bound over `Q_BV ∪ Q_tr ∪ Q₀ ∪ Q₊` is (4.7) for
+  `ρ = 1_P`. -/
+structure SieveInputs (A : AnalyticInputs) where
+  Equidistributed : StadlmannSupport → Prop
+  VariationalIneq : StadlmannSupport → Prop
+  theorem_4_10 : ∀ T : StadlmannSupport, T.Valid → Equidistributed T → VariationalIneq T →
+    DHL T.k 2
+  theorem_11_1 : VariationalIneq table3Support
+  equidistributed_of_coverage : A.PositiveLevel → A.HalfLevel → Equidistributed table3Support
+
+end BGP212.Gap
