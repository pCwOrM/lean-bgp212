+    capStep_table3, capStep_zero_fails_table3, v2d_spec_discharged]
+  axioms_used: [propext, Quot.sound, Classical.choice]
+  trusted_base: "Lean 4 kernel + core + Mathlib (Track B, pinned 85e3a25)"
+  controls:
+    - change: "n = 0 at Table 3: U(∅) = min(L, max(g, C(1))) = 777/1250, and (3/5) ∈ T̃₁ via fibre_equiv"
+      result: "accepted (ok_endpoint, ok_endpoint_value)"
+    - change: "endpoint with C(s) in place of C(s+1) (U = g): (3/5) ∉ T̃₁; U(∅) = 41/625"
+      result: "rejected (nc_endpoint_Cs, nc_endpoint_value)"
+    - change: "cap function with C(1) = 1/10, C(2) = 1 (step 9/10 > g): x̂ = (1/5) violates its cap, yet (1/5, 1/2) ∈ T̃₂"
+      result: "accepted (ok_capstep_needed); the empty-fibre claim without CapStep is rejected (nc_capstep)"
+    - change: "C(0) = −1: x̂ = ∅ violates its cap, yet (1/2) ∈ T̃₁"
+      result: "accepted (ok_cap0_needed); the empty-fibre claim without 0 ≤ C 0 is rejected (nc_cap0)"
