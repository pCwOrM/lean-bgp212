import BGP212.Params
import BGP212.Ledger

/-! # A3: the factor-packing conditions of Lemma 7.10

Lemma 7.10 asserts conditions (A)–(E) of Proposition 7.8 for every rough profile in
`Ξ(B₁,ₘ, B₁,ₘ′, m, m′, δ)`, `1 ≤ m ≤ m′ ≤ 13`: 91 pairs × 5 conditions = 455 roots.

* `InXi` is Definition 7.4: `m` and `m′` coordinates in `[δ, 1]`, side sums at most the caps.
* `Packs caps items` is a partition `I₁ ∪ … ∪ Iₖ` of the coordinates with `Σ_{Iᵢ} ≤ capᵢ`,
  encoded as an assignment of each coordinate to a bin index; empty parts are allowed.
* The capacities transcribe Proposition 7.8 with `ω(1,1) = (A₁ + A₁)/2 − 1/4` (the single
  band, `n = 1`) and `ϵ = εₐ = 10⁻¹⁰`.
* `Root c m m′` is Lemma 7.10's claim for one root; for (D) it is uniform over the full box
  `0 ≤ ω₀ ≤ ω(1,1)`, `2/5 − εₐ ≤ γ ≤ 1/3 + 8ω(1,1) + 7δ/3 + 3εₐ`.
* `settledRoots` and `openRoots` are the A3a ledger: 296 roots proved here, 159 left open. -/

namespace BGP212.Packing

open BGP212.Params BGP212.Ledger

/-- **Definition 7.4.** `ys`, `ys'` are the two sides of a rough profile in
`Ξ(B1, B2, m, m′, δ)`. -/
def InXi (B1 B2 : Rat) (m m' : Nat) (ys ys' : List Rat) : Prop :=
  ys.length = m ∧ ys'.length = m' ∧ (∀ y ∈ ys ++ ys', δ ≤ y ∧ y ≤ 1) ∧
    ys.sum ≤ B1 ∧ ys'.sum ≤ B2

/-- The load of bin `k` under the assignment `assign` of items to bins. -/
def binSum (items : List Rat) (assign : List Nat) (k : Nat) : Rat :=
  (((items.zip assign).filter (fun p => p.2 == k)).map (·.1)).sum

/-- A partition of `items` into the bins of `caps`, each part within its capacity. -/
def Packs (caps items : List Rat) : Prop :=
  ∃ assign : List Nat, assign.length = items.length ∧ (∀ a ∈ assign, a < caps.length) ∧
    ∀ k, k < caps.length → binSum items assign k ≤ caps[k]!

/-- `ω(j, j′) = (A_j + A_j′)/2 − 1/4` for the single band `j = j′ = 1` (Proposition 7.8). -/
def ω11 : Rat := (A1 + A1) / 2 - 1 / 4

/-- Proposition 7.8 (A), first partition (the range γ ≤ 1/2). -/
def capsA1 : List Rat := [ξ1 - 2 * εa, 1 / 6 - 4 * ω11 - 2 * εa]
/-- Proposition 7.8 (A), second partition (the range γ > 1/2). -/
def capsA2 : List Rat := [1 / 2 - 2 * ω11 - 2 * εa, 1 / 14 - 68 / 14 * ω11 - 2 * εa]
/-- Proposition 7.8 (B), Type IIa. -/
def capsB : List Rat :=
  [2 / 5 + 24 * ω11 / 5 + 7 * δ / 5 - 2 * εa, 1 / 14 - 24 * ω11 / 7 - 2 * εa]
/-- Proposition 7.8 (C), Type IIb. -/
def capsC : List Rat :=
  [1 / 3 + 24 * ω11 / 3 + 7 * δ / 3 - 4 * εa, 1 / 10 - 34 * ω11 / 5 - 7 * δ / 5 - 4 * εa,
   2 * ω11 + δ - 4 * εa]
/-- Proposition 7.8 (D), Type IIc, at the point `(γ, ω₀)`. -/
def capsD (γ ω0 : Rat) : List Rat :=
  [γ - 2 * δ - 8 * ω0 - εa, 1 / 2 - γ - 2 * ω0 - εa, 4 * ω0 + δ - εa, 8 * ω0]
/-- Proposition 7.8 (E), Type III. -/
def capsE : List Rat := [1 - 6 * ω11 - 3 * ξ3 / 2 - 2 * εa, 5 * ω11 / 2 + 3 * ξ3 / 8 - 2 * εa]

/-- The five conditions of Proposition 7.8. -/
inductive Cond | A | B | C | D | E
  deriving DecidableEq, Repr

/-- **Lemma 7.10, one root.** Every profile in `Ξ(B₁,ₘ, B₁,ₘ′, m, m′, δ)` satisfies condition
`c`; condition (D) uniformly over its full `(γ, ω₀)` box. -/
def Root : Cond → Nat → Nat → Prop
  | .A, m, m' => ∀ ys ys', InXi (B m) (B m') m m' ys ys' →
      Packs capsA1 (ys ++ ys') ∧ Packs capsA2 (ys ++ ys')
  | .B, m, m' => ∀ ys ys', InXi (B m) (B m') m m' ys ys' → Packs capsB (ys ++ ys')
  | .C, m, m' => ∀ ys ys', InXi (B m) (B m') m m' ys ys' → Packs capsC (ys ++ ys')
  | .D, m, m' => ∀ ys ys', InXi (B m) (B m') m m' ys ys' →
      ∀ γ ω0 : Rat, 0 ≤ ω0 → ω0 ≤ ω11 →
        2 / 5 - εa ≤ γ → γ ≤ 1 / 3 + 8 * ω11 + 7 * δ / 3 + 3 * εa →
        Packs (capsD γ ω0) (ys ++ ys')
  | .E, m, m' => ∀ ys ys', InXi (B m) (B m') m m' ys ys' → Packs capsE (ys ++ ys')

/-- All 455 roots of Lemma 7.10: five conditions over A1's 91 pairs `1 ≤ m ≤ m′ ≤ 13`. -/
def allRoots : List (Cond × Nat × Nat) :=
  [Cond.A, Cond.B, Cond.C, Cond.D, Cond.E].flatMap fun c =>
    packingPairs.map fun p => (c, p.1, p.2)

